# Backend
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/turattext
DATABASE_USERNAME=turattext
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-32-random-bytes-base64-or-long-secret
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=30

# Server directory
TURATTEXT_SERVER_ID=00000000-0000-0000-0000-000000000001
TURATTEXT_SERVER_NAME=Main TuratText Server
TURATTEXT_SERVER_BASE_URL=http://localhost:8080
TURATTEXT_SERVER_SELF_REGISTER=false

# Admin panel and backups
TURATTEXT_ADMIN_PASSWORD=
TURATTEXT_ADMIN_TOKEN_TTL_MINUTES=60
TURATTEXT_BACKUP_ENABLED=true
TURATTEXT_BACKUP_DIRECTORY=./backups
TURATTEXT_BACKUP_INTERVAL_MS=21600000
TURATTEXT_BACKUP_INITIAL_DELAY_MS=60000

# Client
TURATTEXT_DEFAULT_SERVER=http://150.241.86.227:8080
