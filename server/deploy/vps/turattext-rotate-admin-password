#!/usr/bin/env bash
set -euo pipefail

password_file="${TURATTEXT_ADMIN_PASSWORD_FILE:-/home/codex-deploy/turattext/app/admin-password}"
password_dir="$(dirname "$password_file")"

umask 077
mkdir -p "$password_dir"
temporary_file="$(mktemp "$password_dir/.admin-password.XXXXXX")"
trap 'rm -f "$temporary_file"' EXIT

openssl rand -base64 24 | tr '+/' '-_' | tr -d '=\n' > "$temporary_file"
printf '\n' >> "$temporary_file"
chmod 600 "$temporary_file"
mv -f "$temporary_file" "$password_file"
trap - EXIT

echo "TuratText admin password rotated."
