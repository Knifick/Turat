{$TURATTEXT_DOMAIN} {
    tls {$ACME_EMAIL}
    encode zstd gzip
    request_body {
        max_size 110MB
    }
    handle_path /updates/* {
        root * /srv/updates
        header Cache-Control "public, max-age=300"
        file_server
    }
    handle {
        reverse_proxy node:8080
    }
}
