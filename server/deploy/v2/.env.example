TURATTEXT_DOMAIN=node.example.org
ACME_EMAIL=admin@example.org
TURATTEXT_SERVER_NAME=My TuratText Node
POSTGRES_PASSWORD=replace-with-random-value
JWT_SECRET=unused-in-v2-only-but-must-be-random
TURATTEXT_V2_REGISTRATION_POW_BITS=18
TURATTEXT_V2_ENVELOPE_POW_BITS=10
TURATTEXT_V2_CONTACT_POW_BITS=18
TURATTEXT_V2_CONTACT_MAX_ENVELOPE_BYTES=65536
TURATTEXT_V2_CONTACT_MAX_ENVELOPES=64
TURATTEXT_V2_REQUESTS_PER_MINUTE=1200
# Адрес UDP-ретранслятора звонков, если он отличается от TURATTEXT_DOMAIN
# (например, домен за CDN, который не пропускает UDP). Пусто — берётся домен Node.
TURATTEXT_CALL_PUBLIC_HOST=
