<Window
    x:Class="TuratText.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:TuratText.Windows"
    Title="Turat">

    <Grid x:Name="Root" Background="{ThemeResource TgWindow}" Loaded="Root_Loaded">
        <Grid.Resources>

            <!-- Строка списка чатов: аватар, имя, время, превью, счётчик. -->
            <DataTemplate x:Key="ChatItemTemplate" x:DataType="local:ChatModel">
                <Grid Padding="12,8,14,8" ColumnDefinitions="Auto,*" ColumnSpacing="12"
                      ContextRequested="Chat_ContextRequested">
                    <Grid Width="54" Height="54">
                        <Border CornerRadius="27" Background="{x:Bind AvatarBrush}">
                            <Grid>
                                <TextBlock Text="{x:Bind Initials}" FontSize="19" FontWeight="SemiBold"
                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image Source="{x:Bind local:Images.Decode(AvatarBase64)}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Ellipse Width="14" Height="14" Fill="{ThemeResource TgOnline}"
                                 Stroke="{ThemeResource TgWindow}" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Visibility="{x:Bind OnlineVisibility}" />
                    </Grid>

                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                            <TextBlock Text="{x:Bind DisplayName}" Foreground="{ThemeResource TgText}"
                                       FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Viewbox Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center"
                                     Visibility="{x:Bind MutedVisibility}">
                                <Path Data="M12 3 A5 5 0 0 0 7 8 v4 l-1.5 2.5 h13 L17 12 V8 A5 5 0 0 0 12 3 Z M4 4 L20 20"
                                      Stroke="{ThemeResource TgHint}" StrokeThickness="1.6" />
                            </Viewbox>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                <Viewbox Width="15" Height="15" Visibility="{x:Bind SingleTickVisibility}">
                                    <Path Data="M4 12.5 L9 17.5 L20 6.5" Stroke="{ThemeResource TgHint}"
                                          StrokeThickness="1.9" StrokeLineJoin="Round" StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round" />
                                </Viewbox>
                                <Viewbox Width="17" Height="15" Visibility="{x:Bind DoubleTickVisibility}">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="M1.6 12.6 L6 17 L14.2 8.4" Stroke="{ThemeResource TgTick}"
                                              StrokeThickness="1.9" StrokeLineJoin="Round" />
                                        <Path Data="M9.4 15.6 L11.6 17.8 L22.4 6.6" Stroke="{ThemeResource TgTick}"
                                              StrokeThickness="1.9" StrokeLineJoin="Round" />
                                    </Canvas>
                                </Viewbox>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{x:Bind TimeLabel}" Foreground="{ThemeResource TgHint}"
                                       FontSize="12" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4" Margin="0,2,0,0">
                            <TextBlock Text="Черновик:" Foreground="{ThemeResource TgDanger}" FontSize="13"
                                       Visibility="{x:Bind DraftVisibility}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind PreviewText}" Foreground="{ThemeResource TgHint}"
                                       FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <Viewbox Grid.Column="2" Width="14" Height="14" Visibility="{x:Bind PinnedVisibility}">
                                <Path Data="M9 3.6 h6 M10.4 3.6 v6.2 l-2.6 3.6 h8.4 l-2.6 -3.6 V3.6 M12 13.4 v7"
                                      Stroke="{ThemeResource TgHint}" StrokeThickness="1.8" />
                            </Viewbox>
                            <Ellipse Grid.Column="3" Width="10" Height="10" Fill="{x:Bind UnreadBadgeBrush}"
                                     Visibility="{x:Bind UnreadDotVisibility}" VerticalAlignment="Center" />
                            <Border Grid.Column="3" CornerRadius="10" Height="20" MinWidth="20" Padding="6,0"
                                    Background="{x:Bind UnreadBadgeBrush}" Visibility="{x:Bind UnreadVisibility}">
                                <TextBlock Text="{x:Bind UnreadLabel}" Foreground="{ThemeResource TgBadgeText}"
                                           FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </DataTemplate>

            <!-- Найденное сообщение в глобальном поиске. -->
            <DataTemplate x:Key="SearchHitTemplate" x:DataType="local:SearchHitModel">
                <Grid Padding="12,7,14,7" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border Width="46" Height="46" CornerRadius="23" Background="{x:Bind AvatarBrush}">
                        <Grid>
                            <TextBlock Text="{x:Bind Initials}" FontSize="17" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{x:Bind local:Images.Decode(AvatarBase64)}" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{x:Bind DisplayName}" Foreground="{ThemeResource TgText}" FontSize="14"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{x:Bind TimeLabel}" Foreground="{ThemeResource TgHint}"
                                       FontSize="12" />
                        </Grid>
                        <TextBlock Grid.Row="1" Text="{x:Bind Preview}" Foreground="{ThemeResource TgHint}"
                                   FontSize="13" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </Grid>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="SectionHeaderTemplate" x:DataType="local:SectionHeader">
                <TextBlock Text="{x:Bind Title}" Foreground="{ThemeResource TgHint}" FontSize="12"
                           FontWeight="SemiBold" Margin="16,10,0,4" />
            </DataTemplate>

            <local:SidebarTemplateSelector x:Key="SidebarTemplateSelector"
                                           Header="{StaticResource SectionHeaderTemplate}"
                                           Chat="{StaticResource ChatItemTemplate}"
                                           Hit="{StaticResource SearchHitTemplate}" />

            <DataTemplate x:Key="DaySeparatorTemplate" x:DataType="local:DaySeparator">
                <Border HorizontalAlignment="Center" CornerRadius="16" Padding="14,5"
                        Background="{ThemeResource TgServicePill}" Margin="0,10,0,6"
                        BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}">
                    <TextBlock Text="{x:Bind Label}" Foreground="{ThemeResource TgServiceText}" FontSize="12"
                               FontWeight="SemiBold" />
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="IncomingMessageTemplate" x:DataType="local:MessageModel">
                <Grid Margin="{x:Bind RowMargin}" HorizontalAlignment="Stretch">
                    <Border HorizontalAlignment="Left" MaxWidth="560" Padding="12,7,12,7"
                            CornerRadius="{x:Bind BubbleCorners}" Background="{ThemeResource TgBubbleIn}"
                            BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}"
                            ContextRequested="Message_ContextRequested">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ForwardLabel}" Visibility="{x:Bind ForwardVisibility}"
                                       Foreground="{ThemeResource TgAccent}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,3" />
                            <Border Visibility="{x:Bind ReplyVisibility}" Background="{ThemeResource TgQuoteIn}"
                                    CornerRadius="4" Padding="7,3" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Rectangle Width="2" Fill="{ThemeResource TgAccent}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind ReplyAuthor}" Foreground="{ThemeResource TgAccent}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ReplyText}" Foreground="{ThemeResource TgMetaIn}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Visibility="{x:Bind AttachmentVisibility}" ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10" Margin="0,2,0,2">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource TgQuoteIn}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="17" Foreground="{ThemeResource TgAccent}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Attachment.FileName}" Foreground="{ThemeResource TgBubbleInText}"
                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Attachment.SizeLabel}" Foreground="{ThemeResource TgMetaIn}"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind DisplayText}" Visibility="{x:Bind TextVisibility}"
                                           Foreground="{ThemeResource TgBubbleInText}" FontSize="14"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="9,0,0,0"
                                            VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind EditedLabel}" Visibility="{x:Bind EditedVisibility}"
                                               Foreground="{ThemeResource TgMetaIn}" FontSize="11" />
                                    <TextBlock Text="{x:Bind TimeLabel}" Foreground="{ThemeResource TgMetaIn}" FontSize="11" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ReactionSummary}" Visibility="{x:Bind ReactionVisibility}"
                                       FontSize="15" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="OutgoingMessageTemplate" x:DataType="local:MessageModel">
                <Grid Margin="{x:Bind RowMargin}" HorizontalAlignment="Stretch">
                    <Border HorizontalAlignment="Right" MaxWidth="560" Padding="12,7,12,7"
                            CornerRadius="{x:Bind BubbleCorners}" Background="{ThemeResource TgBubbleOut}"
                            BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}"
                            ContextRequested="Message_ContextRequested">
                        <StackPanel>
                            <TextBlock Text="{x:Bind ForwardLabel}" Visibility="{x:Bind ForwardVisibility}"
                                       Foreground="{ThemeResource TgMetaOut}" FontSize="12" FontWeight="SemiBold"
                                       Margin="0,0,0,3" />
                            <Border Visibility="{x:Bind ReplyVisibility}" Background="{ThemeResource TgQuoteOut}"
                                    CornerRadius="4" Padding="7,3" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                    <Rectangle Width="2" Fill="{ThemeResource TgMetaOut}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{x:Bind ReplyAuthor}" Foreground="{ThemeResource TgMetaOut}"
                                                   FontSize="12" FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind ReplyText}" Foreground="{ThemeResource TgMetaOut}"
                                                   FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Grid Visibility="{x:Bind AttachmentVisibility}" ColumnDefinitions="Auto,*"
                                  ColumnSpacing="10" Margin="0,2,0,2">
                                <Border Width="40" Height="40" CornerRadius="20" Background="{ThemeResource TgQuoteOut}">
                                    <FontIcon Glyph="&#xE7C3;" FontSize="17" Foreground="{ThemeResource TgBubbleOutText}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind Attachment.FileName}" Foreground="{ThemeResource TgBubbleOutText}"
                                               FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Attachment.SizeLabel}" Foreground="{ThemeResource TgMetaOut}"
                                               FontSize="12" />
                                </StackPanel>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind DisplayText}" Visibility="{x:Bind TextVisibility}"
                                           Foreground="{ThemeResource TgBubbleOutText}" FontSize="14"
                                           TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" Margin="9,0,0,0"
                                            VerticalAlignment="Bottom">
                                    <TextBlock Text="{x:Bind EditedLabel}" Visibility="{x:Bind EditedVisibility}"
                                               Foreground="{ThemeResource TgMetaOut}" FontSize="11" />
                                    <TextBlock Text="{x:Bind TimeLabel}" Foreground="{ThemeResource TgMetaOut}" FontSize="11" />
                                    <Viewbox Width="15" Height="13" Visibility="{x:Bind SingleTickVisibility}">
                                        <Path Data="M4 12.5 L9 17.5 L20 6.5" Stroke="{ThemeResource TgMetaOut}"
                                              StrokeThickness="1.9" StrokeLineJoin="Round" />
                                    </Viewbox>
                                    <Viewbox Width="17" Height="13" Visibility="{x:Bind DoubleTickVisibility}">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M1.6 12.6 L6 17 L14.2 8.4" Stroke="{ThemeResource TgTick}"
                                                  StrokeThickness="1.9" StrokeLineJoin="Round" />
                                            <Path Data="M9.4 15.6 L11.6 17.8 L22.4 6.6" Stroke="{ThemeResource TgTick}"
                                                  StrokeThickness="1.9" StrokeLineJoin="Round" />
                                        </Canvas>
                                    </Viewbox>
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{x:Bind ReactionSummary}" Visibility="{x:Bind ReactionVisibility}"
                                       FontSize="15" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>

            <!-- Карточка темы: настоящие цвета палитры, поэтому вид темы понятен до её включения. -->
            <DataTemplate x:Key="ThemeCardTemplate" x:DataType="local:ThemePalette">
                <Grid Width="176" Height="96" CornerRadius="10" Background="{x:Bind Preview}"
                      BorderBrush="{x:Bind BorderBrush}" BorderThickness="1" Padding="11">
                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="0,14,0,0">
                        <Border Width="30" Height="12" CornerRadius="6" Background="{x:Bind AccentBrush}" />
                        <Border Width="16" Height="12" CornerRadius="6" Background="{x:Bind AccentSoftBrush}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind Title}" Foreground="{x:Bind TitleBrush}" FontSize="13"
                               FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                </Grid>
            </DataTemplate>

            <local:MessageTemplateSelector x:Key="MessageTemplateSelector"
                                           Day="{StaticResource DaySeparatorTemplate}"
                                           Incoming="{StaticResource IncomingMessageTemplate}"
                                           Outgoing="{StaticResource OutgoingMessageTemplate}" />
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Своя полоса заголовка: как в Unigram, окно рисует её само. -->
        <Border x:Name="TitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center" Margin="10,0,0,0">
                <Image Source="ms-appx:///Assets/Turat.png" Width="22" Height="22" Stretch="Uniform" />
                <TextBlock Text="Turat" Foreground="{ThemeResource TgHint}" FontSize="12"
                           VerticalAlignment="Center" />
                <Border Width="1" Height="12" Background="{ThemeResource TgDivider}" Margin="4,0" />
                <TextBlock x:Name="ConnectionState" Foreground="{ThemeResource TgHint}" FontSize="12"
                           VerticalAlignment="Center" Text="подключение…" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="64,348,*" Padding="10,0,10,10" ColumnSpacing="10">

            <!-- Левый рельс Unigram: профиль сверху, служебные кнопки снизу. -->
            <Grid Background="{ThemeResource TgRail}" RowDefinitions="Auto,*,Auto"
                  CornerRadius="20" BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}">
                <Button x:Name="ProfileButton" Style="{StaticResource TgIconButton}" Margin="0,10,0,0"
                        HorizontalAlignment="Center" Click="Settings_Click" ToolTipService.ToolTip="Мой профиль">
                    <Border Width="36" Height="36" CornerRadius="18" Background="{ThemeResource TgAccent}">
                        <Grid>
                            <TextBlock x:Name="MyInitials" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource TgOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="MyAvatar" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                </Button>

                <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,10" HorizontalAlignment="Center">
                    <Button Style="{StaticResource TgIconButton}" Click="Sync_Click"
                            ToolTipService.ToolTip="Обновить сейчас (клиент синхронизируется сам)">
                        <FontIcon Glyph="&#xE72C;" FontSize="16" />
                    </Button>
                    <Button x:Name="ThemeButton" Style="{StaticResource TgIconButton}" Click="Theme_Click"
                            ToolTipService.ToolTip="Сменить тему">
                        <FontIcon x:Name="ThemeIcon" Glyph="&#xE706;" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource TgIconButton}" Click="Settings_Click" ToolTipService.ToolTip="Настройки">
                        <FontIcon Glyph="&#xE713;" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Список чатов -->
            <Grid Grid.Column="1" Background="{ThemeResource TgPanel}" RowDefinitions="Auto,*"
                  CornerRadius="20" BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}">
                <Border Height="52" Padding="10,0" VerticalAlignment="Center">
                    <Border CornerRadius="18" Background="{ThemeResource TgField}" Height="36" Padding="12,0"
                            BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE721;" FontSize="14" Foreground="{ThemeResource TgHint}"
                                      VerticalAlignment="Center" />
                            <TextBox x:Name="SearchInput" Grid.Column="1" PlaceholderText="Поиск"
                                     BorderThickness="0" Background="Transparent" Padding="0,4,0,4"
                                     Foreground="{ThemeResource TgText}" TextChanged="SearchInput_TextChanged"
                                     VerticalAlignment="Center">
                                <TextBox.Resources>
                                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                </TextBox.Resources>
                            </TextBox>
                            <Button Grid.Column="2" x:Name="ClearSearchButton" Style="{StaticResource TgIconButton}"
                                    Padding="4" Visibility="Collapsed" Click="ClearSearch_Click">
                                <FontIcon Glyph="&#xE711;" FontSize="11" />
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <Grid Grid.Row="1">
                    <ListView x:Name="ChatsList" SelectionMode="Single"
                              ItemContainerStyle="{StaticResource TgChatItem}"
                              ItemTemplateSelector="{StaticResource SidebarTemplateSelector}"
                              ContainerContentChanging="ChatsList_ContainerContentChanging"
                              SelectionChanged="ChatsList_SelectionChanged" />

                    <TextBlock x:Name="EmptyChats" Text="Здесь появятся ваши чаты" Foreground="{ThemeResource TgHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                    <Button Style="{StaticResource TgAccentCircle}" HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" Margin="0,0,18,18" Click="NewContact_Click"
                            ToolTipService.ToolTip="Новый диалог">
                        <FontIcon Glyph="&#xE70F;" FontSize="17" />
                    </Button>
                </Grid>
            </Grid>

            <!-- Диалог -->
            <Grid Grid.Column="2" Background="{ThemeResource TgWallpaper}"
                  RowDefinitions="Auto,Auto,*,Auto,Auto"
                  CornerRadius="20" BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}">

                <Grid x:Name="ConversationHeader" Height="60" Padding="14,0" Background="{ThemeResource TgPanel}"
                      CornerRadius="20,20,0,0"
                      ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Visibility="Collapsed">
                    <Grid Width="40" Height="40" Tapped="ContactProfile_Tapped">
                        <Border CornerRadius="20" Background="{ThemeResource TgAccent}">
                            <Grid>
                                <TextBlock x:Name="ContactInitial" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource TgOnAccent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="ContactAvatar" Stretch="UniformToFill" />
                            </Grid>
                        </Border>
                        <Ellipse x:Name="ContactOnline" Width="11" Height="11" Fill="{ThemeResource TgOnline}"
                                 Stroke="{ThemeResource TgPanel}" StrokeThickness="2"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Tapped="ContactProfile_Tapped">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock x:Name="ContactTitle" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TgText}" />
                            <Viewbox x:Name="ContactMuted" Width="14" Height="14" Visibility="Collapsed">
                                <Path Data="M12 3 A5 5 0 0 0 7 8 v4 l-1.5 2.5 h13 L17 12 V8 A5 5 0 0 0 12 3 Z M4 4 L20 20"
                                      Stroke="{ThemeResource TgHint}" StrokeThickness="1.6" />
                            </Viewbox>
                        </StackPanel>
                        <TextBlock x:Name="ContactStatus" Foreground="{ThemeResource TgHint}" FontSize="12" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                        <Button Style="{StaticResource TgIconButton}" Click="ChatMenu_Click" ToolTipService.ToolTip="Ещё">
                            <FontIcon Glyph="&#xE712;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Grid x:Name="SelectionBar" Height="60" Padding="8,0" Background="{ThemeResource TgPanel}"
                      CornerRadius="20,20,0,0"
                      ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" Visibility="Collapsed">
                    <Button Style="{StaticResource TgIconButton}" Click="ClearSelection_Click">
                        <FontIcon Glyph="&#xE711;" FontSize="15" />
                    </Button>
                    <TextBlock x:Name="SelectionCount" Grid.Column="1" VerticalAlignment="Center" Margin="10,0"
                               FontWeight="SemiBold" Foreground="{ThemeResource TgText}" />
                    <Button Grid.Column="2" Style="{StaticResource TgIconButton}" Click="ReactSelected_Click"
                            ToolTipService.ToolTip="Реакция">
                        <FontIcon Glyph="&#xE76E;" FontSize="15" />
                    </Button>
                    <Button Grid.Column="3" Style="{StaticResource TgIconButton}" Click="ForwardSelected_Click"
                            ToolTipService.ToolTip="Переслать">
                        <FontIcon Glyph="&#xE72D;" FontSize="15" />
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource TgIconButton}" Click="Copy_Click"
                            ToolTipService.ToolTip="Копировать">
                        <FontIcon Glyph="&#xE8C8;" FontSize="15" />
                    </Button>
                    <Button x:Name="EditSelectedButton" Grid.Column="5" Style="{StaticResource TgIconButton}"
                            Click="EditSelected_Click" ToolTipService.ToolTip="Изменить">
                        <FontIcon Glyph="&#xE70F;" FontSize="15" />
                    </Button>
                    <Button Grid.Column="6" Style="{StaticResource TgIconButton}" Click="DeleteSelected_Click"
                            ToolTipService.ToolTip="Удалить">
                        <FontIcon Glyph="&#xE74D;" FontSize="15" Foreground="{ThemeResource TgDanger}" />
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" Background="{ThemeResource TgDivider}" />

                <Grid x:Name="EmptyConversation" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="16" Padding="16,8" Background="{ThemeResource TgServicePill}">
                        <TextBlock Text="Выберите, кому написать" Foreground="{ThemeResource TgServiceText}"
                                   FontSize="13" />
                    </Border>
                </Grid>

                <ListView x:Name="MessagesList" Grid.Row="2" Padding="10,4,10,10" SelectionMode="Extended"
                          ItemContainerStyle="{StaticResource TgMessageItem}"
                          ItemTemplateSelector="{StaticResource MessageTemplateSelector}"
                          SelectionChanged="MessagesList_SelectionChanged"
                          ContainerContentChanging="MessagesList_ContainerContentChanging"
                          Visibility="Collapsed" />

                <Border x:Name="ComposerBanner" Grid.Row="3" Background="{ThemeResource TgPanel}" Padding="14,6"
                        Visibility="Collapsed">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                        <FontIcon x:Name="BannerIcon" Glyph="&#xE70F;" FontSize="14" Foreground="{ThemeResource TgAccent}"
                                  VerticalAlignment="Center" />
                        <Rectangle Grid.Column="1" Width="2" Fill="{ThemeResource TgAccent}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock x:Name="BannerTitle" Foreground="{ThemeResource TgAccent}" FontSize="12"
                                       FontWeight="SemiBold" />
                            <TextBlock x:Name="BannerText" Foreground="{ThemeResource TgHint}" FontSize="12"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                        <Button Grid.Column="3" Style="{StaticResource TgIconButton}" Click="CancelBanner_Click">
                            <FontIcon Glyph="&#xE711;" FontSize="12" />
                        </Button>
                    </Grid>
                </Border>

                <Grid x:Name="Composer" Grid.Row="4" Padding="8" Margin="10,0,10,10"
                      Background="{ThemeResource TgPanel}" CornerRadius="24"
                      BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}"
                      ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6" Visibility="Collapsed">
                    <Button Style="{StaticResource TgIconButton}" Click="Attach_Click" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Прикрепить файл">
                        <FontIcon Glyph="&#xE723;" FontSize="16" />
                    </Button>
                    <TextBox x:Name="ComposerInput" Grid.Column="1"
                             PlaceholderText="Отправить сообщение"
                             AcceptsReturn="True"
                             TextWrapping="Wrap" MaxHeight="140" BorderThickness="0" Background="Transparent"
                             Foreground="{ThemeResource TgText}" FontSize="14" VerticalAlignment="Bottom"
                             PreviewKeyDown="ComposerInput_PreviewKeyDown" TextChanged="ComposerInput_TextChanged">
                        <TextBox.Resources>
                            <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                            <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                            <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                            <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                        </TextBox.Resources>
                    </TextBox>
                    <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource TgAccentCircle}" Width="40"
                            Height="40" CornerRadius="20" Click="Send_Click" IsEnabled="False" VerticalAlignment="Bottom"
                            ToolTipService.ToolTip="Отправить (Enter)">
                        <FontIcon Glyph="&#xE724;" FontSize="15" />
                    </Button>
                </Grid>

                <Grid x:Name="PendingBar" Grid.Row="4" Background="{ThemeResource TgPanel}" Padding="12"
                      Margin="10,0,10,10" CornerRadius="24"
                      BorderThickness="1" BorderBrush="{ThemeResource TgGlassRim}"
                      ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Visibility="Collapsed">
                    <TextBlock Text="Этот пользователь хочет начать переписку" VerticalAlignment="Center"
                               Foreground="{ThemeResource TgHint}" FontSize="13" />
                    <Button Grid.Column="1" Content="Отклонить" Click="RejectContact_Click"
                            Background="Transparent" BorderThickness="0" Foreground="{ThemeResource TgDanger}" />
                    <Button Grid.Column="2" Content="Принять" Click="AcceptContact_Click"
                            Background="{ThemeResource TgAccent}" Foreground="{ThemeResource TgOnAccent}"
                            BorderThickness="0" />
                </Grid>
            </Grid>
        </Grid>

        <!-- Полноэкранные разделы поверх окна: настройки и профиль собеседника. -->
        <Grid x:Name="SettingsPage" Grid.Row="1" Background="{ThemeResource TgOverlay}" Visibility="Collapsed"
              RowDefinitions="Auto,*">
            <Grid Height="56" Padding="10,0" Background="{ThemeResource TgPanel}" ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <Button Style="{StaticResource TgIconButton}" Click="CloseSettings_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <TextBlock Grid.Column="1" Text="Настройки" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{ThemeResource TgText}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel MaxWidth="620" HorizontalAlignment="Center" Padding="20,16,20,32" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,10">
                        <Button Style="{StaticResource TgIconButton}" Padding="0" Click="PickAvatar_Click"
                                ToolTipService.ToolTip="Сменить фото">
                            <Grid Width="86" Height="86">
                                <Border CornerRadius="43" Background="{ThemeResource TgAccent}">
                                    <Grid>
                                        <TextBlock x:Name="SettingsInitials" FontSize="28" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource TgOnAccent}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image x:Name="SettingsAvatar" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource TgAccent}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <FontIcon Glyph="&#xE722;" FontSize="12" Foreground="{ThemeResource TgOnAccent}" />
                                </Border>
                            </Grid>
                        </Button>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="SettingsName" FontSize="19" FontWeight="SemiBold"
                                       Foreground="{ThemeResource TgText}" />
                            <TextBlock x:Name="SettingsState" Foreground="{ThemeResource TgHint}" FontSize="13" />
                            <TextBlock x:Name="MyUserId" Foreground="{ThemeResource TgHint}" FontSize="11"
                                       FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="Профиль" Style="{StaticResource TgSectionTitle}" />
                    <TextBox x:Name="SettingsDisplayName" Header="Видимое имя" />
                    <TextBox x:Name="SettingsUsername" Header="Username" />
                    <TextBox x:Name="SettingsAbout" Header="О себе" AcceptsReturn="True" MaxLength="200" />
                    <Button Content="Сохранить и опубликовать" Click="SaveProfile_Click" Margin="0,10,0,0"
                            Background="{ThemeResource TgAccent}" Foreground="{ThemeResource TgOnAccent}" BorderThickness="0"
                            HorizontalAlignment="Left" />

                    <TextBlock x:Name="ThemeSection" Text="Оформление" Style="{StaticResource TgSectionTitle}" />
                    <TextBlock x:Name="ThemeName" Foreground="{ThemeResource TgHint}" FontSize="13" />
                    <GridView x:Name="ThemeList" Margin="0,8,0,0" Height="452"
                              SelectionMode="Single" IsItemClickEnabled="True" ItemClick="ThemeList_ItemClick"
                              ItemTemplate="{StaticResource ThemeCardTemplate}"
                              ItemContainerStyle="{StaticResource TgThemeItem}"
                              ScrollViewer.VerticalScrollMode="Disabled"
                              ScrollViewer.VerticalScrollBarVisibility="Hidden"
                              ScrollViewer.HorizontalScrollMode="Disabled"
                              HorizontalAlignment="Left" />

                    <TextBlock Text="Конфиденциальность" Style="{StaticResource TgSectionTitle}" />
                    <ToggleSwitch x:Name="PresenceToggle" Header="Последняя активность"
                                  OnContent="Собеседники видят «в сети»" OffContent="Скрыта: всегда «был(а) недавно»"
                                  Toggled="Presence_Toggled" />

                    <TextBlock Text="Сеть" Style="{StaticResource TgSectionTitle}" />
                    <TextBlock x:Name="NetworkHint" Foreground="{ThemeResource TgHint}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBox x:Name="BootstrapInput" Header="Адрес Mailbox Node" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Сохранить Node" Click="Connect_Click" />
                        <Button x:Name="MetadataButton" Click="Metadata_Click" />
                    </StackPanel>

                    <TextBlock Text="Устройства и резервные копии" Style="{StaticResource TgSectionTitle}" />
                    <PasswordBox x:Name="SecurityPassphrase" Header="Пароль пакета" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Создать backup" Click="CreateBackup_Click" />
                        <Button Content="Восстановить backup" Click="RestoreBackup_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Связать устройство" Click="CreateDeviceLink_Click" />
                        <Button Content="Импортировать связь" Click="ImportDeviceLink_Click" />
                    </StackPanel>
                    <TextBox x:Name="RevokeDeviceInput" Header="DeviceID потерянного устройства" Margin="0,8,0,0" />
                    <Button Content="Отозвать устройство" Click="RevokeDevice_Click"
                            Foreground="{ThemeResource TgDanger}" HorizontalAlignment="Left" />

                    <TextBlock Text="Передача без прямого подключения" Style="{StaticResource TgSectionTitle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Экспорт сообщений" Click="ExportPortable_Click" />
                        <Button Content="Доставить пакет" Click="ImportPortable_Click" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Экспорт сети" Click="ExportDiscovery_Click" />
                        <Button Content="Импорт сети" Click="ImportDiscovery_Click" />
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Foreground="{ThemeResource TgHint}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,20,0,0" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="ProfilePage" Grid.Row="1" Background="{ThemeResource TgOverlay}" Visibility="Collapsed"
              RowDefinitions="Auto,*">
            <Grid Height="56" Padding="10,0" Background="{ThemeResource TgPanel}" ColumnDefinitions="Auto,*"
                  ColumnSpacing="8">
                <Button Style="{StaticResource TgIconButton}" Click="CloseProfile_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>
                <TextBlock Grid.Column="1" Text="Профиль" FontSize="17" FontWeight="SemiBold"
                           VerticalAlignment="Center" Foreground="{ThemeResource TgText}" />
            </Grid>
            <ScrollViewer Grid.Row="1">
                <StackPanel MaxWidth="560" HorizontalAlignment="Center" Padding="20,20,20,32" Spacing="10">
                    <Border Width="96" Height="96" CornerRadius="48" Background="{ThemeResource TgAccent}"
                            HorizontalAlignment="Center">
                        <Grid>
                            <TextBlock x:Name="ProfileInitial" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource TgOnAccent}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image x:Name="ProfileAvatar" Stretch="UniformToFill" />
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ProfileName" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{ThemeResource TgText}" />
                    <TextBlock x:Name="ProfilePresence" Foreground="{ThemeResource TgHint}" HorizontalAlignment="Center"
                               FontSize="13" />
                    <TextBlock Text="Данные" Style="{StaticResource TgSectionTitle}" />
                    <TextBlock x:Name="ProfileUsername" Foreground="{ThemeResource TgText}" />
                    <TextBlock x:Name="ProfileUserId" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                               Foreground="{ThemeResource TgHint}" />
                    <TextBlock x:Name="ProfileAbout" TextWrapping="Wrap" Foreground="{ThemeResource TgText}" />
                    <TextBlock Text="Безопасность" Style="{StaticResource TgSectionTitle}" />
                    <ToggleSwitch x:Name="VerifiedToggle" Header="Fingerprint сверен"
                                  OnContent="Ключи подтверждены вручную" OffContent="Ключи ещё не сверены"
                                  Toggled="Verified_Toggled" />
                    <Button Content="Очистить историю" Click="ClearHistory_Click" HorizontalAlignment="Left"
                            Margin="0,10,0,0" />
                    <Button Content="Удалить чат" Click="DeleteChat_Click" Foreground="{ThemeResource TgDanger}"
                            HorizontalAlignment="Left" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <ProgressBar x:Name="BusyIndicator" Grid.Row="1" Height="2" VerticalAlignment="Top" IsIndeterminate="True"
                     Visibility="Collapsed" Foreground="{ThemeResource TgAccent}" />

        <ContentDialog x:Name="NewContactDialog" Title="Новый диалог" PrimaryButtonText="Начать диалог"
                       CloseButtonText="Отмена" PrimaryButtonClick="NewContactDialog_PrimaryButtonClick">
            <StackPanel Spacing="10">
                <TextBlock Text="Введите @username собеседника или его полный UserID." TextWrapping="Wrap"
                           Foreground="{ThemeResource TgHint}" />
                <TextBox x:Name="NewContactInput" PlaceholderText="@username или UserID" />
                <TextBlock x:Name="NewContactError" TextWrapping="Wrap"
                           Foreground="{ThemeResource TgDanger}" Visibility="Collapsed" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="OnboardingDialog" Title="Добро пожаловать в Turat" PrimaryButtonText="Продолжить"
                       PrimaryButtonClick="OnboardingDialog_PrimaryButtonClick">
            <StackPanel Spacing="10">
                <Image Source="ms-appx:///Assets/Turat.png" Width="104" Height="104"
                       HorizontalAlignment="Center" Stretch="Uniform" Margin="0,2,0,8" />
                <TextBlock Text="Придумайте видимое имя и username — их увидят собеседники. Ключи остаются на устройстве."
                           TextWrapping="Wrap" Foreground="{ThemeResource TgHint}" />
                <TextBox x:Name="OnboardingDisplayName" Header="Видимое имя" />
                <TextBox x:Name="OnboardingUsername" Header="Username" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog x:Name="ForwardDialog" Title="Переслать" PrimaryButtonText="Переслать" CloseButtonText="Отмена"
                       PrimaryButtonClick="ForwardDialog_PrimaryButtonClick">
            <ListView x:Name="ForwardList" Height="360" SelectionMode="Single"
                      ItemContainerStyle="{StaticResource TgChatItem}"
                      ItemTemplate="{StaticResource ChatItemTemplate}" />
        </ContentDialog>
    </Grid>
</Window>
