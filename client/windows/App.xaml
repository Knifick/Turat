<Application
    x:Class="TuratText.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Фирменная палитра Turat. Кисти создаются один раз и живут всё время работы
                приложения: смена темы меняет их Color, поэтому уже нарисованные экраны
                перекрашиваются без пересоздания разметки. Значения здесь — тема «Ориджин»,
                фактические цвета выставляет ThemeCatalog при запуске.
            -->
            <SolidColorBrush x:Key="TgWindow" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TgPanel" Color="#1C1C1C" />
            <SolidColorBrush x:Key="TgRail" Color="#171717" />
            <SolidColorBrush x:Key="TgElevated" Color="#242424" />
            <SolidColorBrush x:Key="TgField" Color="#2B2B2B" />
            <SolidColorBrush x:Key="TgDivider" Color="#353535" />
            <SolidColorBrush x:Key="TgText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TgHint" Color="#9A9A9A" />
            <SolidColorBrush x:Key="TgAccent" Color="#C9354A" />
            <SolidColorBrush x:Key="TgOnAccent" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TgAccentSoft" Color="#572832" />
            <SolidColorBrush x:Key="TgBubbleIn" Color="#292929" />
            <SolidColorBrush x:Key="TgBubbleOut" Color="#C9354A" />
            <SolidColorBrush x:Key="TgBubbleInText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TgBubbleOutText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TgMetaIn" Color="#969696" />
            <SolidColorBrush x:Key="TgMetaOut" Color="#FFD7DD" />
            <SolidColorBrush x:Key="TgQuoteIn" Color="#33C9354A" />
            <SolidColorBrush x:Key="TgQuoteOut" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="TgTick" Color="#FFD7DD" />
            <SolidColorBrush x:Key="TgServicePill" Color="#CC242424" />
            <SolidColorBrush x:Key="TgServiceText" Color="#B5B5B5" />
            <SolidColorBrush x:Key="TgBadge" Color="#C9354A" />
            <SolidColorBrush x:Key="TgBadgeMuted" Color="#5C5C5C" />
            <SolidColorBrush x:Key="TgBadgeText" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TgOnline" Color="#4CCC5E" />
            <SolidColorBrush x:Key="TgDanger" Color="#EC6A65" />
            <SolidColorBrush x:Key="TgRowActive" Color="#572832" />
            <SolidColorBrush x:Key="TgRowHover" Color="#262626" />
            <SolidColorBrush x:Key="TgSelection" Color="#40C9354A" />
            <LinearGradientBrush x:Key="TgWallpaper" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#1C1C1C" Offset="0" />
                <GradientStop Color="#211B1C" Offset="1" />
            </LinearGradientBrush>

            <!-- Прозрачная кнопка-иконка: подсветка только при наведении. -->
            <Style x:Key="TgIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="{ThemeResource TgHint}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}"
                                  Padding="{TemplateBinding Padding}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgField}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Content.Opacity" Value="0.4" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter x:Name="Content"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Круглая акцентная кнопка: отправка и «новый чат». -->
            <Style x:Key="TgAccentCircle" TargetType="Button" BasedOn="{StaticResource TgIconButton}">
                <Setter Property="Background" Value="{ThemeResource TgAccent}" />
                <Setter Property="Foreground" Value="{ThemeResource TgOnAccent}" />
                <Setter Property="CornerRadius" Value="22" />
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="Root" Background="{TemplateBinding Background}"
                                  CornerRadius="{TemplateBinding CornerRadius}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.88" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.75" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Opacity" Value="0.35" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  Foreground="{TemplateBinding Foreground}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка чата во всю ширину: активная строка залита, без «пилюли» WinUI. -->
            <Style x:Key="TgChatItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Background="Transparent">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowHover}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowActive}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowActive}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgRowActive}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Строка сообщения: выделение подсвечивает всю строку, как в Telegram. -->
            <Style x:Key="TgMessageItem" TargetType="ListViewItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListViewItem">
                            <Grid x:Name="Root" Background="Transparent" Padding="6,0">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver" />
                                        <VisualState x:Name="Pressed" />
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgSelection}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgSelection}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Root.Background" Value="{ThemeResource TgSelection}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalContentAlignment="Stretch" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Карточка темы: выбранная обведена акцентом, наведённая — приглушённой рамкой. -->
            <Style x:Key="TgThemeItem" TargetType="GridViewItem">
                <Setter Property="Margin" Value="0,0,10,10" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridViewItem">
                            <Border x:Name="Ring" CornerRadius="13" BorderThickness="2"
                                    BorderBrush="Transparent" Padding="1">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource TgHint}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource TgAccent}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Selected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource TgAccent}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOverSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource TgAccent}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PressedSelected">
                                            <VisualState.Setters>
                                                <Setter Target="Ring.BorderBrush" Value="{ThemeResource TgAccent}" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="TgSectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{ThemeResource TgAccent}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,18,0,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
