<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TuratText.Client.Views"
             xmlns:vm="clr-namespace:TuratText.Client.ViewModels"
             x:Class="TuratText.Client.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://TuratText.Client/Assets/Styles.axaml" />
  </Application.Styles>

  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type vm:LocalFirstMessengerViewModel}">
      <views:LocalFirstMessengerView />
    </DataTemplate>
  </Application.DataTemplates>
</Application>
