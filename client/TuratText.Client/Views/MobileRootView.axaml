<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:TuratText.Client.Views"
             xmlns:vm="clr-namespace:TuratText.Client.ViewModels"
             x:Class="TuratText.Client.Views.MobileRootView"
             x:DataType="vm:MainWindowViewModel">
  <UserControl.DataTemplates>
    <DataTemplate DataType="{x:Type vm:LocalFirstMessengerViewModel}">
      <views:LocalFirstMessengerView />
    </DataTemplate>
  </UserControl.DataTemplates>
  <ContentControl Content="{Binding CurrentViewModel}" />
</UserControl>
